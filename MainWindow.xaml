<Window x:Class="ExifBatchEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ExifBatchEditor.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EXIF Batch Metadata Editor v3.0.1" Height="1100" Width="1740"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:PlaceholderVisibilityConverter x:Key="PlaceholderVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save Changes" Padding="8,4" Click="SaveChanges_Click" Background="LightGreen"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddFilesButton" Content="Add Files..." Padding="8,4" Margin="0,0,6,0" Click="AddFiles_Click"/>
                <Button x:Name="AddFolderButton" Content="Add Folder..." Padding="8,4" Click="AddFolder_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Loading progress (hidden unless a load is in progress) -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="LoadingStatusText" Margin="0,0,0,2"/>
            <ProgressBar x:Name="LoadingProgressBar" Height="16" Minimum="0"/>
        </StackPanel>

        <!-- Main content: file list + tags on top, preview + map below -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="380"/>
            </Grid.RowDefinitions>

            <!-- Top: file list | tag grid -->
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" TextWrapping="Wrap"
                           Text="Files (drag and drop files/folders here, or drag selected files out to another app - multi-select to edit tags across all of them at once)"/>
                <ListBox x:Name="FileListBox" SelectionMode="Extended"
                         SelectionChanged="FileListBox_SelectionChanged"
                         MouseDoubleClick="FileListBox_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="FileListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="FileListBox_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="FileListBox_PreviewMouseMove"
                         AllowDrop="True" DragEnter="FileListBox_DragEnter" Drop="FileListBox_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" Background="#22000000" Margin="0,0,8,0"
                                        MouseEnter="Thumbnail_MouseEnter" MouseLeave="Thumbnail_MouseLeave">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                                <!-- Always-live editable filename, same pattern as the tag grid's
                                     Value column - click in, type, commit on LostFocus/Enter. The
                                     * column is Auto, so this TextBox stretches to fill whatever
                                     room the file list panel has. -->
                                <TextBox Grid.Column="1" Text="{Binding FileName, Mode=OneWay}"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" Padding="0"
                                         GotFocus="FileNameEditor_GotFocus"
                                         LostFocus="FileNameEditor_LostFocus"
                                         PreviewKeyDown="FileNameEditor_PreviewKeyDown"/>
                                <TextBlock Grid.Column="2" Text=" *" VerticalAlignment="Center" FontWeight="Bold"
                                           Foreground="DarkRed"
                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Bulk Rename Selected..." Padding="8,4" Margin="0,0,6,0" Click="BulkRename_Click"/>
                    <Button Content="Find and Replace..." Padding="8,4" Margin="0,0,6,0" Click="FindReplace_Click"/>
                    <Button Content="Select All" Padding="8,4" Margin="0,0,6,0" Click="SelectAll_Click"/>
                    <Button Content="Remove Selected" Padding="8,4" Click="RemoveFiles_Click"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right side: tag grid + bulk panel -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Raw tag editor - shows the first selected file's tags as an editable
                     template. With multiple files selected, committing an edit here applies
                     and saves it to every selected file. -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" TextWrapping="Wrap"
                               Text="Tags (click Value to edit - with multiple files selected, edits apply to all of them)"/>
                    <DataGrid x:Name="TagGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended"
                              EnableRowVirtualization="False" EnableColumnVirtualization="False"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.IsVirtualizing="False"
                              AlternationCount="2" AlternatingRowBackground="#FFEDEDED">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="IFD" Binding="{Binding Ifd}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="110"/>
                            <!-- Value column: the TextBox/ComboBox editors are always live (not a
                                 separate "click to enter edit mode" template) - this makes single-
                                 click-to-type an architectural guarantee rather than something that
                                 depends on DataGrid's edit-mode timing, which proved unreliable. -->
                            <DataGridTemplateColumn Header="Value" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox x:Name="TextEditor" BorderThickness="0" Background="Transparent"
                                                     GotFocus="ValueEditor_GotFocus"
                                                     LostFocus="ValueEditor_LostFocus"
                                                     Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{Binding Example, StringFormat='e.g. {0}'}" Padding="4,0"
                                                       VerticalAlignment="Center" Foreground="Gray" FontStyle="Italic"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Opacity>
                                                    <MultiBinding Converter="{StaticResource PlaceholderVisibilityConverter}">
                                                        <Binding Path="ValueText"/>
                                                        <Binding Path="Example"/>
                                                    </MultiBinding>
                                                </TextBlock.Opacity>
                                            </TextBlock>
                                            <!-- Tag here (on the ComboBox itself, not its items - the items'
                                                 Tag is the SelectedValuePath) identifies which EditorKind this
                                                 editor belongs to, so the handler can ignore spurious selection
                                                 changes from this always-present-but-collapsed-for-this-row
                                                 dropdown: since it shares the same ValueText binding as the
                                                 visible text box, typing a character that happens to match one
                                                 of its items' Tag (e.g. a stray "1" matching "Below Sea Level")
                                                 would otherwise silently reselect it and fire SelectionChanged
                                                 even though it's invisible and the user never touched it. -->
                                            <ComboBox x:Name="AltRefEditor" Tag="AltitudeRef" Visibility="Collapsed"
                                                      SelectedValuePath="Tag" SelectionChanged="RefComboBox_SelectionChanged"
                                                      SelectedValue="{Binding ValueText, Mode=OneWay}">
                                                <ComboBoxItem Content="Above Sea Level" Tag="0"/>
                                                <ComboBoxItem Content="Below Sea Level" Tag="1"/>
                                            </ComboBox>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EditorKind}" Value="AltitudeRef">
                                                <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="AltRefEditor" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Add Tag..." Padding="8,4" Margin="0,0,6,0" Click="AddTag_Click"/>
                    <Button Content="Remove Selected Tag(s)" Padding="8,4" Click="RemoveTag_Click"/>
                </StackPanel>
            </Grid>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="12" Background="LightGray"/>

            <!-- Bottom: preview | edit | map -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Preview: hovering a thumbnail in the file list for 1 second shows a larger
                     version here (see Thumbnail_MouseEnter/Leave in MainWindow.xaml.cs). Also
                     shows the live result of the Edit panel's sliders for the selected file. -->
                <DockPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" TextWrapping="Wrap" Text="Preview"/>
                    <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged">
                        <TextBlock x:Name="PreviewPlaceholderText" Text="Hover over a thumbnail to preview"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>

                        <!-- Positioned/sized in code (UpdateCropOverlayBounds) to exactly match
                             PreviewImage's actual rendered rect within this cell - Stretch="Uniform"
                             letterboxes, so this can't just fill the whole Grid cell. -->
                        <Canvas x:Name="CropOverlayCanvas" Visibility="Collapsed" ClipToBounds="True">
                            <Border x:Name="CropRectBorder" BorderBrush="White" BorderThickness="1.5"
                                    Background="#01000000">
                                <Grid>
                                    <Thumb x:Name="CropMoveThumb" Background="Transparent"
                                           DragDelta="CropMoveThumb_DragDelta" Cursor="SizeAll"/>
                                    <Thumb x:Name="CropTopLeftThumb" Width="12" Height="12" Background="White"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Margin="-6,-6,0,0" Cursor="SizeNWSE"
                                           DragDelta="CropResizeThumb_DragDelta" Tag="TopLeft"/>
                                    <Thumb x:Name="CropTopRightThumb" Width="12" Height="12" Background="White"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,-6,-6,0" Cursor="SizeNESW"
                                           DragDelta="CropResizeThumb_DragDelta" Tag="TopRight"/>
                                    <Thumb x:Name="CropBottomLeftThumb" Width="12" Height="12" Background="White"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Margin="-6,0,0,-6" Cursor="SizeNESW"
                                           DragDelta="CropResizeThumb_DragDelta" Tag="BottomLeft"/>
                                    <Thumb x:Name="CropBottomRightThumb" Width="12" Height="12" Background="White"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Margin="0,0,-6,-6" Cursor="SizeNWSE"
                                           DragDelta="CropResizeThumb_DragDelta" Tag="BottomRight"/>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

                <!-- Edit: Light/Color/Effects sliders for the selected file, applied live to
                     the Preview panel. Nothing here is saved until the Save button is clicked
                     (see PhotoEditState/PhotoAdjustments/FileEntry.SaveEdit). DataContext is set
                     in code (UpdatePreview et al.) to the selected file, so {Binding Edit} below
                     resolves to its PhotoEditState and everything inside binds directly to it. -->
                <DockPanel x:Name="EditPanelRoot" Grid.Column="2" Margin="6,0,6,0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" Text="Edit"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Save" Padding="8,4" Margin="0,0,6,0" Click="SaveEdit_Click" Background="LightGreen"/>
                        <Button Content="Revert" Padding="8,4" Click="RevertEdit_Click"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Edit}">
                        <StackPanel Margin="0,0,4,0">
                            <Image x:Name="HistogramImage" Height="80" Stretch="Fill" Margin="0,0,0,8"/>

                            <ToggleButton x:Name="CropToggleButton" Content="Crop" Padding="8,4" Margin="0,0,0,8"
                                          HorizontalAlignment="Left"
                                          Checked="CropToggle_Changed" Unchecked="CropToggle_Changed"/>

                            <Expander Header="Light" IsExpanded="True" Margin="0,0,0,4">
                                <StackPanel Margin="4">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Exposure" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-5" Maximum="5" VerticalAlignment="Center"
                                                Value="{Binding Exposure, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Exposure, StringFormat={}{0:0.00}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Contrast" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Contrast, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Highlights" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Highlights, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Highlights, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Shadows" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Shadows, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Shadows, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Whites" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Whites, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Whites, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Blacks" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Blacks, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Blacks, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Color" Margin="0,0,0,4">
                                <StackPanel Margin="4">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Temperature" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Temperature, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tint" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Tint, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Tint, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Vibrance" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Vibrance, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Vibrance, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Saturation" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Saturation, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Saturation, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Effects" Margin="0,0,0,4">
                                <StackPanel Margin="4">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Texture" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Texture, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Texture, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Clarity" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Clarity, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Clarity, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Dehaze" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Dehaze, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Dehaze, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Grain" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Grain, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Grain, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Glow" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Glow, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Glow, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontSize="11" TextAlignment="Right" BorderThickness="1" Padding="1,0" Margin="2,0,0,0" PreviewKeyDown="SliderValueBox_PreviewKeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="LightGray"/>

                <!-- Map: shows a pin for each currently-selected file that has GPS
                     coordinates, kept in sync via UpdateMap() in MainWindow.xaml.cs. -->
                <DockPanel Grid.Column="4" Margin="6,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" TextWrapping="Wrap" Text="Map"/>
                    <TextBlock x:Name="MapUnavailableText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="DarkRed"
                               Visibility="Collapsed" Margin="0,0,0,4"
                               Text="Map unavailable - the WebView2 Runtime (bundled with most current Windows/Edge installs) could not be found."/>
                    <wv2:WebView2 x:Name="MapView"/>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" Padding="4,2" Foreground="DarkGreen" FontWeight="Bold"/>
    </Grid>
</Window>
