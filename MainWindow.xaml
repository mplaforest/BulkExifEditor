<Window x:Class="ExifBatchEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ExifBatchEditor.Converters"
        Title="EXIF Batch Metadata Editor v1.0.17" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:PlaceholderVisibilityConverter x:Key="PlaceholderVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save Changes" Padding="8,4" Click="SaveChanges_Click" Background="LightGreen"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddFilesButton" Content="Add Files..." Padding="8,4" Margin="0,0,6,0" Click="AddFiles_Click"/>
                <Button x:Name="AddFolderButton" Content="Add Folder..." Padding="8,4" Margin="0,0,6,0" Click="AddFolder_Click"/>
                <Button Content="Remove Selected" Padding="8,4" Click="RemoveFiles_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Loading progress (hidden unless a load is in progress) -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="LoadingStatusText" Margin="0,0,0,2"/>
            <ProgressBar x:Name="LoadingProgressBar" Height="16" Minimum="0"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" TextWrapping="Wrap"
                           Text="Files (drag and drop files/folders here - multi-select to edit tags across all of them at once)"/>
                <ListBox x:Name="FileListBox" SelectionMode="Extended"
                         SelectionChanged="FileListBox_SelectionChanged"
                         MouseDoubleClick="FileListBox_MouseDoubleClick"
                         AllowDrop="True" DragEnter="FileListBox_DragEnter" Drop="FileListBox_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" Background="#22000000" Margin="0,0,8,0">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                                <!-- Always-live editable filename, same pattern as the tag grid's
                                     Value column - click in, type, commit on LostFocus/Enter. The
                                     * column is Auto, so this TextBox stretches to fill whatever
                                     room the file list panel has. -->
                                <TextBox Grid.Column="1" Text="{Binding FileName, Mode=OneWay}"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" Padding="0"
                                         GotFocus="FileNameEditor_GotFocus"
                                         LostFocus="FileNameEditor_LostFocus"
                                         PreviewKeyDown="FileNameEditor_PreviewKeyDown"/>
                                <TextBlock Grid.Column="2" Text=" *" VerticalAlignment="Center" FontWeight="Bold"
                                           Foreground="DarkRed"
                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right side: tag grid + bulk panel -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Raw tag editor - shows the first selected file's tags as an editable
                     template. With multiple files selected, committing an edit here applies
                     and saves it to every selected file. -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" TextWrapping="Wrap"
                               Text="Tags (click Value to edit - with multiple files selected, edits apply to all of them)"/>
                    <DataGrid x:Name="TagGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended"
                              EnableRowVirtualization="False" EnableColumnVirtualization="False"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.IsVirtualizing="False"
                              AlternationCount="2" AlternatingRowBackground="#FFEDEDED">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="IFD" Binding="{Binding Ifd}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="110"/>
                            <!-- Value column: the TextBox/ComboBox editors are always live (not a
                                 separate "click to enter edit mode" template) - this makes single-
                                 click-to-type an architectural guarantee rather than something that
                                 depends on DataGrid's edit-mode timing, which proved unreliable. -->
                            <DataGridTemplateColumn Header="Value" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox x:Name="TextEditor" BorderThickness="0" Background="Transparent"
                                                     GotFocus="ValueEditor_GotFocus"
                                                     LostFocus="ValueEditor_LostFocus"
                                                     Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{Binding Example, StringFormat='e.g. {0}'}" Padding="4,0"
                                                       VerticalAlignment="Center" Foreground="Gray" FontStyle="Italic"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Opacity>
                                                    <MultiBinding Converter="{StaticResource PlaceholderVisibilityConverter}">
                                                        <Binding Path="ValueText"/>
                                                        <Binding Path="Example"/>
                                                    </MultiBinding>
                                                </TextBlock.Opacity>
                                            </TextBlock>
                                            <!-- Tag here (on the ComboBox itself, not its items - the items'
                                                 Tag is the SelectedValuePath) identifies which EditorKind this
                                                 editor belongs to, so the handler can ignore spurious selection
                                                 changes from these other two, always-present-but-collapsed-for-
                                                 this-row dropdowns: since all three share the same ValueText
                                                 binding as the visible text box, typing a character that happens
                                                 to match one of their items' Tag (e.g. a stray "1" matching
                                                 AltRefEditor's "Below Sea Level") silently reselects it and fires
                                                 SelectionChanged even though it's invisible and the user never
                                                 touched it. -->
                                            <ComboBox x:Name="LatRefEditor" Tag="LatitudeRef" Visibility="Collapsed"
                                                      SelectedValuePath="Tag" SelectionChanged="RefComboBox_SelectionChanged"
                                                      SelectedValue="{Binding ValueText, Mode=OneWay}">
                                                <ComboBoxItem Content="North" Tag="N"/>
                                                <ComboBoxItem Content="South" Tag="S"/>
                                            </ComboBox>
                                            <ComboBox x:Name="LonRefEditor" Tag="LongitudeRef" Visibility="Collapsed"
                                                      SelectedValuePath="Tag" SelectionChanged="RefComboBox_SelectionChanged"
                                                      SelectedValue="{Binding ValueText, Mode=OneWay}">
                                                <ComboBoxItem Content="East" Tag="E"/>
                                                <ComboBoxItem Content="West" Tag="W"/>
                                            </ComboBox>
                                            <ComboBox x:Name="AltRefEditor" Tag="AltitudeRef" Visibility="Collapsed"
                                                      SelectedValuePath="Tag" SelectionChanged="RefComboBox_SelectionChanged"
                                                      SelectedValue="{Binding ValueText, Mode=OneWay}">
                                                <ComboBoxItem Content="Above Sea Level" Tag="0"/>
                                                <ComboBoxItem Content="Below Sea Level" Tag="1"/>
                                            </ComboBox>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EditorKind}" Value="LatitudeRef">
                                                <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="LatRefEditor" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EditorKind}" Value="LongitudeRef">
                                                <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="LonRefEditor" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EditorKind}" Value="AltitudeRef">
                                                <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="AltRefEditor" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Add Tag..." Padding="8,4" Margin="0,0,6,0" Click="AddTag_Click"/>
                    <Button Content="Remove Selected Tag(s)" Padding="8,4" Click="RemoveTag_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" Padding="4,2" Foreground="DarkGreen" FontWeight="Bold"/>
    </Grid>
</Window>
