<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExifBatchEditor</RootNamespace>
    <AssemblyName>ExifBatchEditor</AssemblyName>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExifLibNet" Version="2.1.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- map.html is bundled locally rather than loaded via NavigateToString - a real origin
       behaves more predictably in WebView2. GoogleMapsApiKey.txt (gitignored, not
       committed) also lives here and is copied alongside it; see InitMapAsync. -->
  <ItemGroup>
    <Content Include="MapAssets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
